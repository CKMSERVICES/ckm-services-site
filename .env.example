# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.ckmservices.fr

# --- Email (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sending address on your Resend domain
LEAD_FROM_EMAIL=leads@ckmservices.fr
# Where new leads should land — your real inbox
LEAD_TO_EMAIL=contact@ckmservices.fr

# --- WhatsApp ---
# No API key needed: the site uses a free wa.me click-to-chat link.
# Set the real number in lib/constants.ts (`whatsapp` field), digits only,
# country code first, e.g. "15550102024".

# --- reCAPTCHA v3 ---
# https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
